{
  "name": "HelloWorld",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "start:dev": "cross-env APP_ENV=development react-native start --reset-cache",
    "start:staging": "cross-env APP_ENV=staging react-native start --reset-cache",
    "start:prod": "cross-env APP_ENV=production react-native start --reset-cache",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "splash:generate": "react-native-bootsplash generate src/assets/bootsplash/logo.svg --platforms=android,ios --background=4F46E5 --logo-width=120 --assets-output=src/assets/bootsplash"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.0",
    "i18next": "^26.7.1",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.12",
    "react-native": "0.88.1",
    "react-native-bootsplash": "7.3.5",
    "react-native-gesture-handler": "3.4.0",
    "react-native-localize": "3.7.2",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.1",
    "react-redux": "^9.3.1",
    "redux-persist": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "jest": "^29.6.3",
    "prettier": "^3.9.10",
    "react-native-svg-transformer": "^1.5.3",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
